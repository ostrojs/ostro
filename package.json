{
    "name": "@ostro/ostro",
    "version": "2.0.0-alpha.3",
    "description": "OstroJS MVC framework for NodeJS",
    "keywords": [
        "framework",
        "ostrojs",
        "mvc",
        "MVC framework",
        "nodejs framework"
    ],
    "author": "amar",
    "license": "MIT",
    "scripts": {
        "test": "npx c8 npx jest",
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "build": "rm -rf build && mkdir -p build && node scripts/build.js",
        "build:clean": "rm -rf build && npm run build",
        "server:start": "ts-node src/app.ts",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/framework": "^2.0.0-alpha.2"
    },
    "devDependencies": {
        "@popperjs/core": "^2.10.2",
        "@types/node": "^22.0.0",
        "axios": "^1.10.0",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.21",
        "postcss": "^8.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/ostro.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/ostro/issues"
    },
    "homepage": "https://github.com/ostrojs/ostro#readme",
    "main": "src/app.ts",
    "types": "src/app.ts",
    "files": [
        "build"
    ],
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
