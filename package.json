{
    "name": "@ostro/ostro",
    "version": "2.0.0-alpha.8",
    "description": "OstroJS MVC framework for NodeJS",
    "keywords": [
        "framework",
        "ostrojs",
        "mvc",
        "MVC framework",
        "nodejs framework"
    ],
    "author": "amar",
    "license": "MIT",
    "scripts": {
        "test": "jest",
        "dev": "npm run development",
        "development": "mix --mix-config=src/webpack.mix.ts",
        "watch": "mix watch --mix-config=src/webpack.mix.ts",
        "watch-poll": "mix watch --mix-config=src/webpack.mix.ts -- --watch-options-poll=1000",
        "hot": "mix watch --hot --mix-config=src/webpack.mix.ts",
        "prod": "npm run production",
        "build": "npm run lint:check && rm -rf build && mkdir -p build && ts-node scripts/build.ts",
        "build:clean": "rm -rf build && npm run build",
        "server:start": "ts-node src/app.ts",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "dependencies": {
        "@ostro/framework": "^2.0.0-alpha.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@ostro/builder": "^2.0.0-alpha.1",
        "@popperjs/core": "^2.11.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "axios": "^1.20.0",
        "eslint": "^9.20.0",
        "jest": "^30.5.2",
        "laravel-mix": "^6.0.49",
        "postcss": "^8.1.14",
        "ts-loader": "^9.5.2",
        "webpack": "5.99.9",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.24.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/ostro.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/ostro/issues"
    },
    "homepage": "https://github.com/ostrojs/ostro#readme",
    "main": "src/app.ts",
    "types": "src/app.ts",
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}