{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "isolatedModules": true,
        "outDir": ".dist",
        "rootDir": "src",
        "paths": {
            "~/*": [
                "./src/*"
            ]
        },
        "skipLibCheck": true,
        "noImplicitAny": true,
        "strict": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "test",
        "src/test",
        "build",
        "jest.config.ts",
        "src/jest.config.ts",
        "src/vite.config.ts",
        "vite.config.ts",
        "src/webpack.mix.ts",
        "webpack.mix.ts"
    ]
}