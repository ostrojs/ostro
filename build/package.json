{
  "name": "@ostro/ostro",
  "version": "2.0.0-alpha.13",
  "description": "OstroJS MVC framework for NodeJS",
  "keywords": [
    "framework",
    "ostrojs",
    "mvc",
    "MVC framework",
    "nodejs framework"
  ],
  "author": "amar",
  "license": "MIT",
  "scripts": {
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "npm run development",
    "development": "vite build",
    "watch": "vite build --watch",
    "watch-poll": "vite build --watch",
    "vite": "vite",
    "prod": "npm run production",
    "production": "vite build",
    "build": "npm run lint:check && ostro-build",
    "build:clean": "rm -rf .dist && npm run build",
    "server:start": "ts-node app.ts",
    "test": "npx jest"
  },
  "dependencies": {
    "@ostro/framework": "^2.0.0-alpha.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@ostro/builder": "^2.0.0-alpha.1",
    "@ostro/vite": "^2.0.0-alpha.11",
    "@popperjs/core": "^2.11.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "axios": "^1.20.0",
    "eslint": "^9.20.0",
    "jest": "^30.5.2",
    "postcss": "^8.1.14",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/ostro.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/ostro/issues"
  },
  "homepage": "https://github.com/ostrojs/ostro#readme",
  "main": "app.ts",
  "types": "app.ts"
}
